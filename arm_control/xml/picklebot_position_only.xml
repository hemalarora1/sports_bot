<redisConfiguration namespacePrefix="opensai" />

<robotControlConfiguration robotName="FrankaRobot"
	robotModelFile="${SAI_MODEL_URDF_FOLDER}/panda/panda_arm_sphere.urdf">

	<logger logFolderName="log_files/single_panda/controllers"
		enabledAtStartup="true"
		addTimestampToFilename="false" />

	<controller name="cartesian_controller">
		<motionForceTask name="cartesian_task"
			linkName="end-effector">
			<velocitySaturation enabled="false" />
			<otg type="acceleration"
				maxLinearVelocity="0.15"
				maxAngularVelocity="1.0"
				maxLinearAcceleration="1.5"
				maxAngularAcceleration="3.0"
				maxLinearJerk="5.0"
				maxAngularJerk="100" />
			<compliantFrame xyz="0 0 0.35"
							rpy="0 0 0" />
			<positionGains kp="100.0" kv="20.0" ki="0.0"/>
			<orientationGains kp="0.0" kv="0.0" ki="0.0"/>
		</motionForceTask>
	</controller>

	<controller name="joint_controller">
		<jointTask name="joint_task">
			<velocitySaturation enabled="true"
				velocityLimit="0.6 0.7 0.8 0.9 1.0 1.1 1.2" />
			<otg type="disabled"/>
			<gains kp="100.0" kv="20.0" ki="0.0" />
		</jointTask>
	</controller>

</robotControlConfiguration>
